<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EAxWiki.Core\EAxWiki.Core.csproj" />
    <ProjectReference Include="..\EAxWiki.EA\EAxWiki.EA.csproj" />
    <ProjectReference Include="..\EAxWiki.Export\EAxWiki.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI wrapper used by LocalConfigStore to encrypt the saved .eaxwiki connection string at rest -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>EAxWiki.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include repository root markdown files (e.g., README.md) -->
    <None Include="..\\..\\*.md" />

    <!-- Include all markdown files in the wiki folder and preserve folder structure in Solution Explorer -->
    <None Include="..\\..\\wiki\\**\\*.md">
      <Link>wiki\\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Add top-level repo files and scripts as linked items so Solution Explorer can show them from the project -->
  <ItemGroup>
    <None Include="..\\README.md">
      <Link>RepoRoot\\README.md</Link>
    </None>
    <None Include="..\\install.ps1">
      <Link>RepoRoot\\install.ps1</Link>
    </None>
    <None Include="..\\scripts\\**\\*.ps1">
      <Link>RepoRoot\\scripts\\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\\docs\\**\\*.md">
      <Link>RepoRoot\\docs\\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>


</Project>
